const pacote = require('pacote');
const semver = require('semver');
const fs = require('fs-extra');
const tar = require('tar');
const path = require('path');
const os = require('os');
const npmConf = require('npm-conf');

function safeTempName(pkgName, version) {
  return pkgName.replace(/[\/@]/g, '_') + '-' + version + '-';
}

function getAuthOptionsFromNpmrc(registry) {
  const conf = npmConf();
  const opts = conf.toJSON();
  const regUrl = registry || conf.get('registry');

  // Normalize registry key (npm-conf stores them like '//registry.npmjs.org/')
  const regKey = regUrl.replace(/^https?:/, '');

  const username = conf.get(`${regKey}:username`);
  const passwordEncoded = conf.get(`${regKey}:_password`);
  const alwaysAuth = conf.get(`${regKey}:always-auth`);

  const headers = {};
  if (username && passwordEncoded) {
    const decodedPassword = Buffer.from(passwordEncoded, 'base64').toString('utf8');
    const token = Buffer.from(`${username}:${decodedPassword}`).toString('base64');
    headers['authorization'] = `Basic ${token}`;
  }

  return {
    registry: regUrl,
    headers,
    alwaysAuth
  };
}

async function mergePackageHistory(pkgName, pkgHistoryCount, destDir, registry) {
  const authOpts = getAuthOptionsFromNpmrc(registry);

  const manifest = await pacote.packument(pkgName, authOpts);
  const allVersions = Object.keys(manifest.versions)
    .filter(v => !semver.prerelease(v))
    .sort(semver.compare);

  const selectedVersions = allVersions.slice(-pkgHistoryCount);

  console.log(`Found ${allVersions.length} GA versions. Processing last ${pkgHistoryCount}:`);
  console.log(selectedVersions.join(', '));

  await fs.ensureDir(destDir);

  for (const version of selectedVersions) {
    const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), safeTempName(pkgName, version)));

    console.log(`Downloading ${pkgName}@${version}...`);
    await pacote.extract(`${pkgName}@${version}`, tempDir, authOpts);

    console.log(`Merging ${pkgName}@${version} into ${destDir}...`);
    await fs.copy(tempDir, destDir, {
      overwrite: true,
      errorOnExist: false
    });

    await fs.remove(tempDir);
  }

  console.log(`Done! Merged ${pkgHistoryCount} latest GA versions of ${pkgName} into ${destDir}`);
}


if (require.main === module) {
  const args = process.argv.slice(2);
  const [pkgName, pkgHistoryCountStr, destDir] = args.filter(arg => !arg.startsWith('--'));
  const registryArg = args.find(arg => arg.startsWith('--registry='));
  const registry = registryArg ? registryArg.split('=')[1] : null;

  if (!pkgName || !pkgHistoryCountStr || !destDir) {
    console.error('Usage: node merge-npm-history.js <package-name> <history-count> <destination-path> [--registry=https://custom-registry]');
    process.exit(1);
  }

  const pkgHistoryCount = parseInt(pkgHistoryCountStr, 10);
  if (isNaN(pkgHistoryCount) || pkgHistoryCount <= 0) {
    console.error('Error: history-count must be a positive number.');
    process.exit(1);
  }

  mergePackageHistory(pkgName, pkgHistoryCount, destDir, registry)
    .catch(err => {
      console.error('Error:', err);
      process.exit(1);
    });
}

