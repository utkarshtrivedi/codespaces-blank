const pacote = require('pacote');
const semver = require('semver');
const fs = require('fs-extra');
const tar = require('tar');
const path = require('path');
const os = require('os');
const npmConf = require('npm-conf');

// ---- CONFIG ----
/** 
 * **Change this array to configure your tasks**
 */
const tasks = [
  {
    pkgName: '@angular/core',
    srcPath: './local-source',
    destPath: './output-angular-core',
    count: 5
  },
  {
    pkgName: 'lodash',
    srcPath: './local-lodash-snippet',
    destPath: './output-lodash',
    count: 3
  }
];
// ---- END CONFIG ----

function safeTempName(pkgName, version) {
  return pkgName.replace(/[\/@]/g, '_') + '-' + version + '-';
}

function getAuthOptionsFromNpmrc(registry) {
  const conf = npmConf();
  const opts = conf.toJSON();
  const regUrl = registry || conf.get('registry');
  const regKey = regUrl.replace(/^https?:/, '');

  const username = conf.get(`${regKey}:username`);
  const passwordEncoded = conf.get(`${regKey}:_password`);
  const alwaysAuth = conf.get(`${regKey}:always-auth`);

  const headers = {};
  if (username && passwordEncoded) {
    const decodedPassword = Buffer.from(passwordEncoded, 'base64').toString('utf8');
    const token = Buffer.from(`${username}:${decodedPassword}`).toString('base64');
    headers['authorization'] = `Basic ${token}`;
  }

  return {
    registry: regUrl,
    headers,
    alwaysAuth
  };
}

async function processTask({ pkgName, count, srcPath, destPath }) {
  const authOpts = getAuthOptionsFromNpmrc();

  console.log(`\n--- Processing ${pkgName} ---`);

  const manifest = await pacote.packument(pkgName, authOpts);
  const allVersions = Object.keys(manifest.versions)
    .filter(v => !semver.prerelease(v))
    .sort(semver.compare);

  const selectedVersions = allVersions.slice(-count);

  console.log(`Found ${allVersions.length} GA versions. Using last ${count}:`);
  console.log(selectedVersions.join(', '));

  await fs.ensureDir(destPath);

  for (const version of selectedVersions) {
    const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), safeTempName(pkgName, version)));

    console.log(`  Downloading ${pkgName}@${version}...`);
    await pacote.extract(`${pkgName}@${version}`, tempDir, authOpts);

    console.log(`  Merging ${pkgName}@${version} into ${destPath}`);
    await fs.copy(tempDir, destPath, {
      overwrite: true,
      errorOnExist: false
    });

    await fs.remove(tempDir);
  }

  if (srcPath && await fs.pathExists(srcPath)) {
    console.log(`  Copying srcPath "${srcPath}" into ${destPath}`);
    await fs.copy(srcPath, destPath, {
      overwrite: true,
      errorOnExist: false
    });
  } else {
    console.warn(`  Skipping srcPath copy: "${srcPath}" does not exist.`);
  }

  console.log(`✓ Done with ${pkgName}\n`);
}

// **ENTRY POINT (NO CLI PARAMS)**
(async () => {
  for (const task of tasks) {
    try {
      await processTask(task);
    } catch (err) {
      console.error(`Error processing ${task.pkgName}:`, err.message || err);
    }
  }

  console.log('\nAll tasks completed.');
})();