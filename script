async function processTask({ pkgName, count, srcPath, destPath }) {
  const authOpts = getAuthOptionsFromNpmrc();

  console.log(`\n--- Processing ${pkgName} ---`);

  const manifest = await pacote.packument(pkgName, authOpts);
  const allVersions = Object.keys(manifest.versions)
    .filter(v => !semver.prerelease(v))
    .sort(semver.compare);

  const selectedVersions = allVersions.slice(-count);

  console.log(`Found ${allVersions.length} GA versions. Using last ${count}:`);
  console.log(selectedVersions.join(', '));

  await fs.ensureDir(destPath);

  for (const version of selectedVersions) {
    const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), safeTempName(pkgName, version)));

    console.log(`  Downloading ${pkgName}@${version}...`);
    await pacote.extract(`${pkgName}@${version}`, tempDir, authOpts);

    const absSrcFromPkg = path.join(tempDir, srcPath);

    if (await fs.pathExists(absSrcFromPkg)) {
      console.log(`  Merging ${pkgName}@${version}:${srcPath} into ${destPath}`);
      await fs.copy(absSrcFromPkg, destPath, {
        overwrite: true,
        errorOnExist: false
      });
    } else {
      console.warn(`  Skipping ${pkgName}@${version}: "${srcPath}" not found`);
    }

    await fs.remove(tempDir);
  }

  console.log(`✓ Done with ${pkgName} → ${destPath}\n`);
}